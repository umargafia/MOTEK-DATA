{
  "expo": {
    "name": "Motek Pay",
    "slug": "motekpay",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.motekpayng.motekpayng"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.motekpayng.motekpayng",
      "versionCode": 3
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "expo.modules": [
      {
        "name": "expo-document-picker",
        "version": "11.2.2"
      }
    ],
    "extra": {
      "oneSignalAppId": "a8a89b80-6e5a-43cb-b00e-7998832a5126",
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "OneSignalNotificationServiceExtension",
                  "bundleIdentifier": "com.motekpayng.motekpayng.OneSignalNotificationServiceExtension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.motekpayng.motekpayng.onesignal"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "f65a56f4-3705-4722-b529-986b9649f6d0"
      }
    },
    "plugins": [
      [
        "onesignal-expo-plugin",
        {
          "mode": "production"
        }
      ]
    ]
  }
}
